{
  "name": "mostly-legal-driving-simulator",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @game/client",
    "server": "npm run dev -w @game/server",
    "build": "npm run build -w @game/client",
    "test": "npm test --workspaces --if-present",
    "typecheck": "tsc -p packages/shared && tsc -p packages/client && tsc -p packages/server",
    "start": "npm run build && npm start -w @game/server"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
